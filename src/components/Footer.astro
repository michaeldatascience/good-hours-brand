---
import Tbd from './Tbd.astro';
import { getActiveProducts, getBundles, getSettings } from '../lib/catalog';

const settings = await getSettings();
const products = await getActiveProducts();
const bundles = (await getBundles()).filter((item) => item.data.status === 'active');
const draft = settings.draft;
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <p class="eyebrow">Products</p>
        <ul>
          {products.map((product) => (
            <li><a href={`/products/${product.id}/`}>{product.data.name}</a></li>
          ))}
          {bundles.map((bundle) => (
            <li><a href={`/bundles/${bundle.id}/`}>{bundle.data.name}</a></li>
          ))}
          <li><a href="/accessories/">Accessories</a></li>
          <li><a href="/compare/">Compare</a></li>
        </ul>
      </div>
      <div>
        <p class="eyebrow">Learn</p>
        <ul>
          <li><a href="/how-it-works/">How it works</a></li>
          <li><a href="/routines/">Routines</a></li>
          <li><a href="/journal/">Journal</a></li>
          <li><a href="/about/">About</a></li>
        </ul>
      </div>
      <div>
        <p class="eyebrow">Help</p>
        <ul>
          <li><a href="/support/">Support</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/shipping/">Shipping</a></li>
          <li><a href="/returns/">Returns</a></li>
          <li><a href="/warranty/">Warranty</a></li>
        </ul>
      </div>
      <div>
        <p class="eyebrow">Company</p>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/safety/">Safety</a></li>
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href="/terms/">Terms</a></li>
        </ul>
      </div>
    </div>
    <p class="disclaimer" style="margin-top: 36px">
      <Tbd value={settings.wellnessDisclaimer} draft={draft} />
    </p>
    <div class="footer-bottom">
      <p class="legal-line">© 2026 {settings.legalName}</p>
      <div class="policy-row">
        <a href="/shipping/">Shipping</a>
        <a href="/returns/">Returns</a>
        <a href="/warranty/">Warranty</a>
        <a href="/safety/">Safety</a>
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
      </div>
    </div>
  </div>
</footer>
