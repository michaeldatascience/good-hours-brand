---
import Tbd from './Tbd.astro';

interface Row {
  label: string;
  ours: string;
  premium: string;
  budget: string;
}

interface Props {
  name: string;
  rows: Row[];
  draft: boolean;
}

const { name, rows, draft } = Astro.props;
---

<div class="table-wrap">
  <table class="compare">
    <thead>
      <tr>
        <th scope="col">Spec</th>
        <th scope="col">{name}</th>
        <th scope="col">Typical premium</th>
        <th scope="col">Typical budget</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <th scope="row">{row.label}</th>
            <td>
              <Tbd value={row.ours} draft={draft} />
            </td>
            <td>
              <Tbd value={row.premium} draft={draft} />
            </td>
            <td>
              <Tbd value={row.budget} draft={draft} />
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
