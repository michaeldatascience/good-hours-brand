---
import Tbd from './Tbd.astro';

interface Row {
  group: string;
  label: string;
  value: string;
}

interface Props {
  rows: Row[];
  draft: boolean;
}

const { rows, draft } = Astro.props;
const groups: { name: string; rows: Row[] }[] = [];
for (const row of rows) {
  const last = groups[groups.length - 1];
  if (!last || last.name !== row.group) groups.push({ name: row.group, rows: [row] });
  else last.rows.push(row);
}
---

<div class="table-wrap">
  <table>
    {
      groups.map((group) => (
        <tbody>
          <tr class="group-row">
            <th colspan="2">{group.name}</th>
          </tr>
          {group.rows.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              <td>
                <Tbd value={row.value} draft={draft} />
              </td>
            </tr>
          ))}
        </tbody>
      ))
    }
  </table>
</div>
