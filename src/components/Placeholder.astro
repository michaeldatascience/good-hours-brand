---
interface Props {
  shape?: 'product' | 'hero' | 'card' | 'journal';
  kind?: 'light' | 'gun' | 'mask' | 'bundle' | 'generic';
  shot?: string;
  draft?: boolean;
  alt: string;
}

const { shape = 'card', kind = 'generic', shot = '', draft = false, alt } = Astro.props;
---

<div class:list={['placeholder', `ratio-${shape}`]} role="img" aria-label={alt}>
  <svg class="device" viewBox="0 0 200 240" fill="none" stroke="#F3EEE6" stroke-width="3" aria-hidden="true">
    {kind === 'light' && (
      <g>
        <rect x="62" y="36" width="76" height="150" rx="16"></rect>
        <circle cx="100" cy="78" r="6" fill="#C4512F" stroke="none"></circle>
        <circle cx="82" cy="100" r="6" fill="#C4512F" stroke="none"></circle>
        <circle cx="118" cy="100" r="6" fill="#C4512F" stroke="none"></circle>
        <circle cx="100" cy="122" r="6" fill="#C4512F" stroke="none"></circle>
        <path d="M78 168h44" stroke="#CBB89A"></path>
      </g>
    )}
    {kind === 'gun' && (
      <g>
        <rect x="36" y="78" width="120" height="36" rx="18"></rect>
        <rect x="108" y="114" width="28" height="70" rx="10"></rect>
        <circle cx="48" cy="96" r="8" fill="#C4512F" stroke="none"></circle>
      </g>
    )}
    {kind === 'mask' && (
      <g>
        <path d="M28 110c18-36 124-36 144 0 8 28-10 58-36 64-18 4-28-8-36-8s-18 12-36 8c-26-6-44-36-36-64Z"></path>
        <circle cx="78" cy="116" r="16"></circle>
        <circle cx="122" cy="116" r="16"></circle>
      </g>
    )}
    {kind === 'bundle' && (
      <g>
        <rect x="40" y="58" width="52" height="110" rx="12"></rect>
        <rect x="108" y="78" width="52" height="90" rx="12"></rect>
        <circle cx="66" cy="96" r="5" fill="#C4512F" stroke="none"></circle>
      </g>
    )}
    {kind === 'generic' && (
      <g>
        <rect x="50" y="48" width="100" height="130" rx="18"></rect>
        <path d="M74 168h52" stroke="#C4512F"></path>
      </g>
    )}
  </svg>
  {draft && shot && <p class="shot-caption">PHOTO: {shot}</p>}
</div>
