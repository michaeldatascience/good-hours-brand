---
import { tbdSegments } from '../lib/format';

interface Props {
  value?: string | number | null;
  draft: boolean;
}

const raw = Astro.props.value == null ? '' : String(Astro.props.value);
const segments = tbdSegments(raw, Astro.props.draft);
---

{
  segments.map((segment) =>
    segment.tbd ? (
      <span class="tbd">
        <span class="tbd-tag">TBD</span>
        {segment.text}
      </span>
    ) : (
      segment.text
    ),
  )
}
