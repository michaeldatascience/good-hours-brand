---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page clocked out early.">
  <section class="section section-dark">
    <div class="wrap stack">
      <p class="eyebrow">404</p>
      <h1>This page clocked out early.</h1>
      <p class="lede">That link does not go anywhere on this site.</p>
      <p style="display:flex; gap:12px; flex-wrap:wrap">
        <a class="btn" href="/">Back home</a>
        <a class="btn btn-ghost" href="/products/">See products</a>
      </p>
    </div>
  </section>
</Base>
